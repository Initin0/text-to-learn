PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/text-to-learn

# Comma separated. "*.vercel.app" allows preview deployments.
CORS_ORIGINS=http://localhost:5173

# Auth0 (Applications > APIs). Issuer must end with a slash.
AUTH0_ISSUER=https://your-tenant.us.auth0.com/
AUTH0_AUDIENCE=https://text-to-learn-api
# Local development only, ignored in production:
AUTH_DISABLED=false

# Google AI Studio key. Leave empty to run with the built-in template engine.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Kore

# Google Cloud > YouTube Data API v3
YOUTUBE_API_KEY=
